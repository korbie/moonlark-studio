# ============================================================================
# Moonlark Studio — backend (Medusa v2) environment
# Copy to `.env` and fill in. Everything here is a PLACEHOLDER.
# ============================================================================

# --- Core ------------------------------------------------------------------
NODE_ENV=development

# Secrets — generate strong random strings for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-random-secret
COOKIE_SECRET=replace-with-random-secret

# --- CORS ------------------------------------------------------------------
# Comma-separated. In production set these to your real domains:
#   STORE_CORS=https://moonlarkstudio.com,https://www.moonlarkstudio.com
#   ADMIN_CORS=https://admin.moonlarkstudio.com
#   AUTH_CORS=https://admin.moonlarkstudio.com,https://moonlarkstudio.com
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000

# --- Database: Neon free Postgres ------------------------------------------
# Neon dashboard -> Connection string. Keep the sslmode flag.
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/moonlark?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# --- Cache/Events: Upstash free Redis (OPTIONAL) ---------------------------
# Leave BLANK to run with in-memory modules (fine for one small instance).
# Upstash dashboard -> "Redis" connection (use the rediss:// TLS URL).
# REDIS_URL=rediss://default:PASSWORD@us1-xxxx.upstash.io:6379
REDIS_URL=

# --- File storage: Cloudflare R2 (S3-compatible) ---------------------------
# R2 dashboard -> create bucket -> "Manage R2 API Tokens" for keys.
# S3_ENDPOINT  = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_FILE_URL  = your public bucket URL or connected custom domain, e.g.
#                https://images.moonlarkstudio.com  (or the r2.dev dev URL)
S3_FILE_URL=https://PLACEHOLDER-public-bucket-url
S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
S3_BUCKET=moonlark-media
S3_REGION=auto
S3_ACCESS_KEY_ID=PLACEHOLDER_R2_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=PLACEHOLDER_R2_SECRET_ACCESS_KEY

# --- Payments: Stripe ------------------------------------------------------
# Stripe dashboard -> Developers -> API keys (use test keys until launch).
# Webhook secret comes from the endpoint you create pointing at:
#   {BACKEND_URL}/hooks/payment/stripe_stripe
STRIPE_API_KEY=sk_test_PLACEHOLDER
STRIPE_WEBHOOK_SECRET=whsec_PLACEHOLDER

# --- Email: Resend ---------------------------------------------------------
# resend.com -> API Keys (a sending-only key is fine). Verify your domain
# (Domains -> Add) to send from your address; until then onboarding@resend.dev
# only delivers to your own Resend account email.
RESEND_API_KEY=re_PLACEHOLDER
RESEND_FROM=Moonlark Studio <orders@moonlarkstudio.com>
