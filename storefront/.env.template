# ============================================================================
# Moonlark Studio — storefront (Next.js) environment
# Copy to `.env.local` and fill in. Everything here is a PLACEHOLDER.
# ============================================================================

# URL of the Medusa backend. Local dev default below; in production set to
# your backend service, e.g. https://api.moonlarkstudio.com
MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key from the backend (printed by `npm run seed`, or find it
# in the admin under Settings -> Publishable API Keys). Starts with pk_...
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_PLACEHOLDER

# Public URL of THIS storefront. In production: https://moonlarkstudio.com
NEXT_PUBLIC_BASE_URL=http://localhost:8000

# Default region (ISO-2, lowercase). We seed a North America (US) region.
NEXT_PUBLIC_DEFAULT_REGION=us

# Stripe publishable key (pk_test_... while testing, pk_live_... at launch).
NEXT_PUBLIC_STRIPE_KEY=pk_test_PLACEHOLDER

# Secret used for Next.js on-demand revalidation. Use any random string.
REVALIDATE_SECRET=replace-with-random-secret

# Optional: only needed if you later move image hosting to Medusa Cloud S3.
MEDUSA_CLOUD_S3_HOSTNAME=
MEDUSA_CLOUD_S3_PATHNAME=
